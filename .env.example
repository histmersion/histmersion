# Histmersion — copy to `.env` and edit. It is gitignored, and every key is optional.
# `.env` is read by `just` (`set dotenv-load`), so these values reach the recipes and the install
# scripts they run. The installed server does NOT read this file: it gets its settings from the
# LaunchAgent's EnvironmentVariables (macOS) or the unit's Environment= lines (Linux), and the
# defaults in modules/core/jvm/src/main/resources/reference.conf cover everything else.

# ── passed to the server by `just install` ───────────────────────────────────────────────────────
# Where `histmersion seed` (with no argument) reads markdown notes from — the research workspace's
# `wiki/sources`. Default: ./corpus in this repo.
# HISTMERSION_CORPUS_DIR=/Users/me/Documents/research/wiki/sources

# The polite-pool identity Crossref/OpenAlex/Unpaywall ask for (User-Agent + mailto). Per install,
# never committed.
# HISTMERSION_ACQUIRE_CONTACT_EMAIL=you@example.org

# ── where things go ──────────────────────────────────────────────────────────────────────────────
# The bundle `just bundle` builds (default: dist/histmersion).
# BUNDLE_DIR=dist/histmersion
# Where the bundle is installed (default: ~/Applications/Histmersion on macOS, ~/.local/opt/histmersion on Linux).
# HISTMERSION_INSTALL_DIR=
# Where the `histmersion` CLI symlink goes (default: ~/bin on macOS, ~/.local/bin on Linux).
# HISTMERSION_BIN_DIR=
# The data directory `just logs` tails (default: ~/Library/Application Support/Histmersion on macOS,
# ${XDG_DATA_HOME:-~/.local/share}/histmersion on Linux).
# HISTMERSION_DATA_DIR=

# ── where the server is ──────────────────────────────────────────────────────────────────────────
# Used by `just health` and `just mcp-json` (which renders .mcp.json and plugin/.mcp.json). Set them
# only when the server listens elsewhere — behind a reverse proxy, or on another machine.
# HISTMERSION_PORT=8000
# HISTMERSION_PUBLIC_URL=http://histmersion.lan:8000
