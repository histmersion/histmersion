# hist-db — copy to `.env` and edit. Every key is optional: the values below are the same defaults
# as modules/core/src/main/resources/reference.conf, so an empty .env changes nothing.
# `.env` is read by docker compose, by install.sh, and by the Makefile. It is gitignored.

# ── network ──────────────────────────────────────────────────────────────────────────────────────
# Port the server listens on (in the container) and is published on (on the host).
HISTDB_PORT=8000

# Host interface compose publishes the server on. 127.0.0.1 = this machine only (default; the write
# endpoints are unauthenticated). Set 0.0.0.0 to expose it on the LAN — only on a network you trust.
HISTDB_BIND=127.0.0.1

# How clients reach the server, and where the CLI looks for it. Both DERIVE from HISTDB_PORT when
# left commented out — which is what you want, so changing the port alone stays consistent. Set them
# explicitly only behind a reverse proxy, or when reaching the server from another machine.
# HISTDB_PUBLIC_URL=http://histdb.lan:8000
# HISTDB_SERVER_URL=http://histdb.lan:8000

# Where install.sh puts the `histdb` binary (default: $HOME/bin). Docker compose also reads this
# file and does NOT expand shell variables, so give an absolute path if you set it.
# HISTDB_BIN_DIR=/usr/local/bin

# ── corpus ───────────────────────────────────────────────────────────────────────────────────────
# HOST path of the markdown corpus (the research workspace's `wiki/sources`). Bind-mounted read-only
# at /corpus in the server container; `histdb seed` (with no argument) imports from there.
HISTDB_CORPUS_DIR=./corpus

# ── backups ──────────────────────────────────────────────────────────────────────────────────────
# SERVER-side directory for `histdb backup` (pg_dump -Fc archives). Inside the container this is the
# `backups` docker volume; `histdb backup --download <dir>` copies an archive to the host from there.
# HISTDB_BACKUPS_DIR=/backups
#
# Only for running the server on the HOST (`sbt server/run`) when pg_dump is not on PATH — macOS
# homebrew keeps libpq keg-only:
# HISTDB_PG_BIN_DIR=/opt/homebrew/opt/libpq/bin

# ── database ─────────────────────────────────────────────────────────────────────────────────────
HISTDB_DB_NAME=histdb
HISTDB_DB_USER=histdb
HISTDB_DB_PASS=histdb
# Host port for the dev override only (docker-compose.dev.yml); the base stack does not publish it.
HISTDB_DB_PORT=5432

# ── converter (OCR sidecar) ──────────────────────────────────────────────────────────────────────
HISTDB_CONVERTER_PORT=8100

# ── map ──────────────────────────────────────────────────────────────────────────────────────────
# Tile URL template for the atlas. Point it at a local tile server to work fully offline.
HISTDB_TILES=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ── grouping (plan §1.6): the atlas "by time" / "by region" tabs and /api/aggregate?by=… ──────────
# How many levels the tree nests by default (1-3), and how many sample sources a leaf lists (0-5).
HISTDB_TREE_DEPTH=2
HISTDB_TREE_SAMPLES=3

# read-only SQL role used by `histdb query` (migration V011 creates it; the server sets this password)
HISTDB_QUERY_PASS=change-me-query
# HISTDB_DB_POOL_MAX=8
