.scala-build/

# native-image
*.build_artifacts.txt
/server
/histmersion
native-image-configs-raw/

# IDE
.idea/
.vscode/

# runtime / data (never commit the corpus or DB dumps)
/data/
*.dump
*.sql.gz
.env

# Python (the converter sidecar is run with uv; its venv/caches stay local)
converter/.venv/
__pycache__/
.pytest_cache/

# Node / Vite (web module)
node_modules/
modules/web/dist/

# OS
.DS_Store

# native-image tracing agent scratch dirs (left behind when a forked run is killed)
agent-pid*/
# ...and the lock/scratch the agent keeps in its config-merge-dir while the app is running
**/META-INF/native-image/.lock
**/META-INF/native-image/agent-extracted-predefined-classes/

# generated by install.sh from the configured port/public URL (see .mcp.json.example)
/.mcp.json
/plugin/.mcp.json

# install.sh scratch / local stack state
/corpus/
/backups/

# native bundle build output (make bundle) and the pixi environment it copies Postgres from
/dist/
runtime/postgres/.pixi/
